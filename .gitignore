# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cloudflare binary
cloudflared.exe
cloudflared

# Virtual environments
venv/
.venv/
env/
ENV/

# Data directories (raw, interim, processed data shouldn't be committed, except deployed JSON files)
data/raw/*
!data/raw/.gitkeep
!data/raw/firms_nrt/
