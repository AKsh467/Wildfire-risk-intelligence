data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/analytics_summary.json
!web/public/data/*

# Model weights and artifacts
models/*
!models/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Spark warehouse / metastore logs
spark-warehouse/
derby.log
metastore_db/

# Streamlit config / cache
.streamlit/

